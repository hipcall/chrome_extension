{
  "name": "Hipcall Extension",
  "version": "0.0.1",
  "manifest_version": 3,
  "description": "Hipcall extension for click to call feature.",
  "homepage_url": "http://hipcall.com",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "default_locale": "tr",
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "js/content_script.js"
      ],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "notifications",
    "webNavigation"
  ],
  "action": {},
  "content_security_policy": {}
}