{
  "name": "Hipcall Development",
  "version": "1.2.0",
  "manifest_version": 3,
  "description": "Bu eklenti Hipcall web telefonunuzu açmanızı, tıklayarak arama yapmanızı (CTI) ve gelen çağrıda bildirim almanızı sağlar.",
  "homepage_url": "https://www.hipcall.com/tr-tr/",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "default_locale": "tr",
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "js/content_script.js"
      ],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "notifications",
    "webNavigation"
  ],
  "action": {},
  "content_security_policy": {}
}